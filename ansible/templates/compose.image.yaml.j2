name: {{ repair_project_name }}
services:
  web:
    image: "{{ repair_image_ref }}"
    pull_policy: never
    ports:
      - "{{ repair_bind_address }}:{{ repair_app_port }}:8000"
    volumes:
      - repair-data:/app/data
    restart: unless-stopped
    stop_grace_period: 20s

volumes:
  repair-data:
